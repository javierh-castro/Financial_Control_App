# Copiá este archivo a .env y completá con los datos de tu proyecto de
# Supabase (Project Settings → API). Solo la URL y la clave publishable
# (anon): esa clave está pensada para ir en el cliente, la protege RLS.
# Nunca pongas acá la clave service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
